<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:Mercury.Editor.ViewModels"
             xmlns:modules="clr-namespace:Mercury.Editor.Models.Modules"
             xmlns:properties="clr-namespace:Mercury.Editor.Models.Modules.Properties"
             xmlns:controls="clr-namespace:Mercury.Editor.Controls"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="Mercury.Editor.Controls.ModuleDescriptionControl"
             x:DataType="modules:ModuleDescription">
    <Grid ColumnDefinitions="Auto,*,Auto" RowDefinitions="Auto,Auto,*">
        <!-- active -->
        <CheckBox Grid.Row="0" Grid.Column="0"
                  IsChecked="{Binding Active}"/>
        
        <!-- name -->
        <TextBlock Grid.Row="0" Grid.Column="1"
                   FontSize="14"
                   VerticalAlignment="Center"
                   FontWeight="Bold"
                   Text="{Binding ModuleName}"/>
        
        <!-- delete -->
        <Button Grid.Row="0" Grid.Column="2" Padding="5"
                Command="{Binding Path=DeleteCommand, RelativeSource={RelativeSource AncestorType=controls:ModuleDescriptionControl}}"
                CommandParameter="{Binding}">
            <TextBlock FontFamily="{StaticResource PhosphorFont}"
                       FontSize="14"
                       Text="&#xE4A6;" Margin="0"/>
        </Button>
        
        <!-- separator -->
        <Rectangle Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3"
                   Fill="{DynamicResource PrimaryForeground}"
                   Margin="0,5"
                   Height="1"/>
        
        <!-- properties -->
        <ItemsControl Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="3"
                      ItemsSource="{Binding Properties}"
                      Margin="0,10,0,0">
            <ItemsControl.DataTemplates>
                <DataTemplate DataType="properties:IntegerModuleProperty">
                    <Grid ColumnDefinitions="Auto,*" Margin="5">
                        <TextBlock Grid.Column="0" 
                                   Text="{Binding Name}"
                                   VerticalAlignment="Center" FontSize="14"
                                   Margin="0,0,15,0"/>
                        <NumericUpDown Grid.Column="1"
                                       Value="{Binding Value}"
                                       Minimum="{Binding Minimum}"
                                       Maximum="{Binding Maximum}"
                                       Increment="1"
                                       FormatString="F0"/>
                    </Grid>
                </DataTemplate>
                <DataTemplate DataType="properties:StringModuleProperty">
                    <Grid ColumnDefinitions="Auto,*" Margin="5">
                        <TextBlock Grid.Column="0" 
                                   Text="{Binding Name}"
                                   VerticalAlignment="Center" FontSize="14"
                                   Margin="0,0,15,0"/>
                        <TextBox Grid.Column="1" Text="{Binding Value}"/>
                    </Grid>
                </DataTemplate>
                <DataTemplate DataType="properties:BooleanModuleProperty">
                    <Grid ColumnDefinitions="Auto,*" Margin="5">
                        <TextBlock Grid.Column="0" 
                                   Text="{Binding Name}"
                                   VerticalAlignment="Center" FontSize="14"
                                   Margin="0,0,15,0"/>
                        <CheckBox Grid.Column="1" IsChecked="{Binding Value}"
                                  Margin="0,5,10,5"/>
                    </Grid>
                </DataTemplate>
            </ItemsControl.DataTemplates>
        </ItemsControl>
    </Grid>
</UserControl>
